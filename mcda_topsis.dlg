/*
  mcda_topsis.dlg  -- dialog for mcda_topsis (open with: db mcda_topsis)
  *! version 1.4.0  23nov2026
  *! Emanuele Clemente, World Bank Group, eclemente@worldbank.org
  One row per criterion: pick a variable, type its weight (or its domain ID and
  set domain weights on the Options tab), tick Cost if higher values should
  LOWER the score (impact -). Empty rows are ignored.
*/
VERSION 16.0
POSITION . . 540 400

DIALOG main, label("mcda_topsis - TOPSIS multi-criteria ranking") tabtitle("Criteria 1-10")
BEGIN
  TEXT tx_hv_main 35 10 200 ., label("Criterion (variable)")
  TEXT tx_hw_main 245 10 70 ., label("Weight")
  TEXT tx_hd_main 325 10 60 ., label("Domain")
  TEXT tx_hc_main 395 10 120 ., label("Cost (impact -)")
  TEXT     tx_n1 10 40 22 ., label("1.")
  VARNAME  vn_1 35 40 200 ., label("Criterion 1")
  EDIT     ed_w1 245 40 70 ., numonly label("Weight 1")
  EDIT     ed_d1 325 40 60 ., numonly label("Domain 1")
  CHECKBOX ck_c1 395 40 120 ., label("Cost")
  TEXT     tx_n2 10 70 22 ., label("2.")
  VARNAME  vn_2 35 70 200 ., label("Criterion 2")
  EDIT     ed_w2 245 70 70 ., numonly label("Weight 2")
  EDIT     ed_d2 325 70 60 ., numonly label("Domain 2")
  CHECKBOX ck_c2 395 70 120 ., label("Cost")
  TEXT     tx_n3 10 100 22 ., label("3.")
  VARNAME  vn_3 35 100 200 ., label("Criterion 3")
  EDIT     ed_w3 245 100 70 ., numonly label("Weight 3")
  EDIT     ed_d3 325 100 60 ., numonly label("Domain 3")
  CHECKBOX ck_c3 395 100 120 ., label("Cost")
  TEXT     tx_n4 10 130 22 ., label("4.")
  VARNAME  vn_4 35 130 200 ., label("Criterion 4")
  EDIT     ed_w4 245 130 70 ., numonly label("Weight 4")
  EDIT     ed_d4 325 130 60 ., numonly label("Domain 4")
  CHECKBOX ck_c4 395 130 120 ., label("Cost")
  TEXT     tx_n5 10 160 22 ., label("5.")
  VARNAME  vn_5 35 160 200 ., label("Criterion 5")
  EDIT     ed_w5 245 160 70 ., numonly label("Weight 5")
  EDIT     ed_d5 325 160 60 ., numonly label("Domain 5")
  CHECKBOX ck_c5 395 160 120 ., label("Cost")
  TEXT     tx_n6 10 190 22 ., label("6.")
  VARNAME  vn_6 35 190 200 ., label("Criterion 6")
  EDIT     ed_w6 245 190 70 ., numonly label("Weight 6")
  EDIT     ed_d6 325 190 60 ., numonly label("Domain 6")
  CHECKBOX ck_c6 395 190 120 ., label("Cost")
  TEXT     tx_n7 10 220 22 ., label("7.")
  VARNAME  vn_7 35 220 200 ., label("Criterion 7")
  EDIT     ed_w7 245 220 70 ., numonly label("Weight 7")
  EDIT     ed_d7 325 220 60 ., numonly label("Domain 7")
  CHECKBOX ck_c7 395 220 120 ., label("Cost")
  TEXT     tx_n8 10 250 22 ., label("8.")
  VARNAME  vn_8 35 250 200 ., label("Criterion 8")
  EDIT     ed_w8 245 250 70 ., numonly label("Weight 8")
  EDIT     ed_d8 325 250 60 ., numonly label("Domain 8")
  CHECKBOX ck_c8 395 250 120 ., label("Cost")
  TEXT     tx_n9 10 280 22 ., label("9.")
  VARNAME  vn_9 35 280 200 ., label("Criterion 9")
  EDIT     ed_w9 245 280 70 ., numonly label("Weight 9")
  EDIT     ed_d9 325 280 60 ., numonly label("Domain 9")
  CHECKBOX ck_c9 395 280 120 ., label("Cost")
  TEXT     tx_n10 10 310 22 ., label("10.")
  VARNAME  vn_10 35 310 200 ., label("Criterion 10")
  EDIT     ed_w10 245 310 70 ., numonly label("Weight 10")
  EDIT     ed_d10 325 310 60 ., numonly label("Domain 10")
  CHECKBOX ck_c10 395 310 120 ., label("Cost")
  TEXT     tx_req_main 10 345 520 ., label("Each variable once; weights (or domain weights) must sum to 1 (+/- 0.01).")
END

DIALOG more, tabtitle("Criteria 11-20")
BEGIN
  TEXT tx_hv_more 35 10 200 ., label("Criterion (variable)")
