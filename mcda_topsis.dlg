  VARNAME  vn_16 35 190 200 ., label("Criterion 16")
  EDIT     ed_w16 245 190 70 ., numonly label("Weight 16")
  EDIT     ed_d16 325 190 60 ., numonly label("Domain 16")
  CHECKBOX ck_c16 395 190 120 ., label("Cost")
  TEXT     tx_n17 10 220 22 ., label("17.")
  VARNAME  vn_17 35 220 200 ., label("Criterion 17")
  EDIT     ed_w17 245 220 70 ., numonly label("Weight 17")
  EDIT     ed_d17 325 220 60 ., numonly label("Domain 17")
  CHECKBOX ck_c17 395 220 120 ., label("Cost")
  TEXT     tx_n18 10 250 22 ., label("18.")
  VARNAME  vn_18 35 250 200 ., label("Criterion 18")
  EDIT     ed_w18 245 250 70 ., numonly label("Weight 18")
  EDIT     ed_d18 325 250 60 ., numonly label("Domain 18")
  CHECKBOX ck_c18 395 250 120 ., label("Cost")
  TEXT     tx_n19 10 280 22 ., label("19.")
