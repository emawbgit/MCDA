  EDIT     ed_d19 325 280 60 ., numonly label("Domain 19")
  CHECKBOX ck_c19 395 280 120 ., label("Cost")
  TEXT     tx_n20 10 310 22 ., label("20.")
  VARNAME  vn_20 35 310 200 ., label("Criterion 20")
  EDIT     ed_w20 245 310 70 ., numonly label("Weight 20")
  EDIT     ed_d20 325 310 60 ., numonly label("Domain 20")
  CHECKBOX ck_c20 395 310 120 ., label("Cost")
  TEXT     tx_req_more 10 345 520 ., label("Each variable once; weights (or domain weights) must sum to 1 (+/- 0.01).")
END

DIALOG opt, tabtitle("Options")
BEGIN
  TEXT tx_if  10  10 500 ., label("Restrict to observations (if expression, optional):")
  EDIT ed_if  10  30 500 ., label("if expression")
  TEXT tx_dw  10  70 520 ., label("Domain weights (optional): weight of the domain typed in each row's Domain field.")
  TEXT tx_dw2 10  88 520 ., label("Each is split equally among its rows (row weights then not needed). Must sum to 1.")
  TEXT tx_dwl1 10 115 120 ., label("Domain 1")
  EDIT ed_dw1 10 133 110 ., numonly label("Domain 1 weight")
  TEXT tx_dwl2 140 115 120 ., label("Domain 2")
  EDIT ed_dw2 140 133 110 ., numonly label("Domain 2 weight")
  TEXT tx_dwl3 270 115 120 ., label("Domain 3")
  EDIT ed_dw3 270 133 110 ., numonly label("Domain 3 weight")
  TEXT tx_dwl4 400 115 120 ., label("Domain 4")
  EDIT ed_dw4 400 133 110 ., numonly label("Domain 4 weight")
  TEXT tx_dwl5 10 160 120 ., label("Domain 5")
  EDIT ed_dw5 10 178 110 ., numonly label("Domain 5 weight")
  TEXT tx_dwl6 140 160 120 ., label("Domain 6")
  EDIT ed_dw6 140 178 110 ., numonly label("Domain 6 weight")
  TEXT tx_dwl7 270 160 120 ., label("Domain 7")
  EDIT ed_dw7 270 178 110 ., numonly label("Domain 7 weight")
  TEXT tx_dwl8 400 160 120 ., label("Domain 8")
  EDIT ed_dw8 400 178 110 ., numonly label("Domain 8 weight")
  BUTTON bu_prev 10 215 160 ., label("Preview weights") onpush(program preview)
  TEXT tx_prev 180 218 340 ., label("Shows the weights tables in the Results window.")
  TEXT tx_gen 10 255 500 ., label("Names for the score and rank variables (optional):")
  EDIT ed_gen 10 275 300 ., label("Score and rank names") option(generate)
END

OK ok1,      label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
HELP hlp1,   view("help mcda_topsis")
RESET res1
COPY copy1

PROGRAM command
BEGIN
  put "mcda_topsis "
  varlist main.vn_1 [main.vn_2] [main.vn_3] [main.vn_4] [main.vn_5] [main.vn_6] [main.vn_7] [main.vn_8] [main.vn_9] [main.vn_10] [more.vn_11] [more.vn_12] [more.vn_13] [more.vn_14] [more.vn_15] [more.vn_16] [more.vn_17] [more.vn_18] [more.vn_19] [more.vn_20]
  if opt.ed_if {
    put " if " opt.ed_if
  }
  beginoptions
    if opt.ed_dw1 {
      put "domainweights("
      if opt.ed_dw1 {
        put opt.ed_dw1 " "
      }
      if opt.ed_dw2 {
        put opt.ed_dw2 " "
      }
      if opt.ed_dw3 {
        put opt.ed_dw3 " "
      }
      if opt.ed_dw4 {
        put opt.ed_dw4 " "
      }
      if opt.ed_dw5 {
        put opt.ed_dw5 " "
      }
      if opt.ed_dw6 {
        put opt.ed_dw6 " "
      }
      if opt.ed_dw7 {
        put opt.ed_dw7 " "
      }
      if opt.ed_dw8 {
        put opt.ed_dw8 " "
      }
      put ") "
    }
    else {
      put "weights("
      if main.vn_1 {
        require main.ed_w1
        put main.ed_w1 " "
      }
      if main.vn_2 {
        require main.ed_w2
        put main.ed_w2 " "
      }
      if main.vn_3 {
        require main.ed_w3
        put main.ed_w3 " "
      }
